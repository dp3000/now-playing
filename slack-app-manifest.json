{
  "display_information": {
    "name": "Now Playing",
    "description": "Syncs the song I'm listening to into my Slack status"
  },
  "oauth_config": {
    "redirect_urls": ["http://localhost:8977/callback"],
    "scopes": {
      "user": ["users.profile:read", "users.profile:write"]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "is_hosted": false,
    "token_rotation_enabled": false
  }
}
